{
  "compilerOptions": {
    "target": "ES2021",
    "module": "Node16",
    "moduleResolution": "Node16",
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "./lib",
    "outDir": "./dist",
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ES2021",
      "DOM"
    ],
    // Explicitly load Node.js definitions (Fixes TS2591)
    "types": [
      "node"
    ],
    // Keep path-rewriting enabled for native node:test execution
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "lib/**/*"
  ]
}