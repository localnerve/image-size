{
  "compilerOptions": {
    "target": "ES2021",
    "module": "Node16",
    "moduleResolution": "Node16",
    "allowJs": false,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": true,
    "lib": [
      "ES2021",
      "DOM"
    ]
  },
  "include": [
    "lib/**/*",
    "specs/**/*"
  ]
}