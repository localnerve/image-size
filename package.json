{
  "name": "@localnerve/image-size",
  "version": "2.1.2",
  "description": "Get dimensions of any image file",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./fromFile": {
      "import": {
        "types": "./dist/fromFile.d.ts",
        "default": "./dist/fromFile.mjs"
      },
      "require": {
        "types": "./dist/fromFile.d.ts",
        "default": "./dist/fromFile.cjs"
      }
    },
    "./types/*": {
      "import": {
        "types": "./dist/types/*.d.ts",
        "default": "./dist/types/*.mjs"
      },
      "require": {
        "types": "./dist/types/*.d.ts",
        "default": "./dist/types/*.cjs"
      }
    }
  },
  "files": [
    "dist",
    "bin/image-size.js"
  ],
  "engines": {
    "node": ">=16.x"
  },
  "bin": {
    "image-size": "bin/image-size.js"
  },
  "scripts": {
    "lint": "biome check lib specs",
    "format": "biome format --write lib specs",
    "test": "node --experimental-test-coverage --test specs/*.spec.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsup && tsc -p tsconfig.build.json",
    "prepack": "npm run clean && npm run build"
  },
  "keywords": [
    "image",
    "size",
    "dimensions",
    "resolution",
    "width",
    "height",
    "avif",
    "bmp",
    "cur",
    "gif",
    "heic",
    "heif",
    "icns",
    "ico",
    "jpeg",
    "jxl",
    "png",
    "psd",
    "svg",
    "tga",
    "tiff",
    "webp"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/localnerve/image-size.git"
  },
  "author": "netroy <aditya@netroy.in> (http://netroy.in/)",
  "contributors": [
    "Alex Grant <alex@localnerve.com> (https://www.localnerve.com)"
  ],
  "maintainers": [
    "Alex Grant <alex@localnerve.com> (https://www.localnerve.com)"
  ],
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/localnerve"
    },
    {
      "type": "paypal",
      "url": "https://www.paypal.com/ncp/payment/DHCB5GUYMGX5U"
    }
  ],
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "26.2.0",
    "tsup": "8.5.1",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "@biomejs/biome": true
  }
}